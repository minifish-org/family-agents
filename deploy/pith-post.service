[Unit]
Description=Pith Post private Matrix agents
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pith-post
Group=pith-post
StateDirectory=pith-post
StateDirectoryMode=0700
WorkingDirectory=/var/lib/pith-post
EnvironmentFile=/etc/pith-post/environment
ExecStart=/usr/local/bin/pith-post serve --http=127.0.0.1:8090 --dir=/var/lib/pith-post/data
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
